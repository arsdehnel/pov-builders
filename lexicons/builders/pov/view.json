{
	"id": "builders.pov.view",
	"lexicon": 1,
	"defs": {
		"valueStance": {
			"type": "object",
			"description": "A user's POV on a specific value within a topic",
			"required": ["value", "stance"],
			"properties": {
				"value": { "type": "ref", "ref": "builders.pov.value#strongRef" },
				"stance": { "type": "ref", "ref": "builders.pov.stance#strongRef" }
			}
		},
		"main": {
			"type": "record",
			"key": "tid",
			"description": "A user's view on a topic, including their overall stance and per-value stances",
			"record": {
				"type": "object",
				"required": ["topic", "overallStance", "createdAt"],
				"properties": {
					"topic": { "type": "ref", "ref": "builders.pov.topic#strongRef" },
					"overallStance": { "type": "ref", "ref": "builders.pov.stance#strongRef" },
					"valueStances": {
						"type": "array",
						"items": { "type": "ref", "ref": "#valueStance" }
					},
					"createdAt": { "type": "string", "format": "datetime" }
				}
			}
		}
	}
}
