{
	"name": "stance-build",
	"version": "0.0.1",
	"private": true,
	"description": "Build a real and shareable stance on the messy topics of the real world",
	"keywords": [],
	"license": "MIT",
	"author": "",
	"type": "module",
	"main": "src/worker.tsx",
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write .",
		"build": "vite build",
		"ci:lint": "pnpm types:check && pnpm biome:check && pnpm knip:check",
		"ci:tests": "pnpm build",
		"clean": "npm run clean:vite",
		"clean:vite": "rm -rf ./node_modules/.vite",
		"content:sync": "tsx scripts/load-topics-from-content.ts",
		"db:apply-migrations-local": "wrangler d1 migrations apply D1_STANCE_BUILD --local",
		"db:generate-migration": "drizzle-kit generate",
		"deploy": "rw-scripts ensure-deploy-env && npm run clean && vite build --mode $CLOUDFLARE_ENV && wrangler d1 migrations apply D1_STANCE_BUILD --remote --env $CLOUDFLARE_ENV && wrangler deploy --env $CLOUDFLARE_ENV",
		"dev": "pnpm run clean:vite && vite dev",
		"dev:docker": "pnpm run clean:vite && vite dev --mode docker",
		"dev:init": "rw-scripts dev-init",
		"docker:down": "docker compose down -v",
		"docker:up": "docker compose up -d",
		"generate": "rw-scripts ensure-env && wrangler types --include-runtime false && tsx scripts/fix-env-types.ts",
		"knip:check": "knip",
		"knip:fix": "knip --fix",
		"prepare": "husky",
		"prettier:check": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"preview": "vite preview",
		"release": "./scripts/semantic-release.sh",
		"release:dry-run": "./scripts/semantic-release.sh --dry-run --no-ci",
		"staged:lint": "lint-staged --allow-empty",
		"types:check": "tsc"
	},
	"dependencies": {
		"@atproto/identity": "^0.5.23",
		"@atproto/syntax": "^0.7.7",
		"@radix-ui/react-icons": "^1.3.2",
		"@storybook/react": "^10.6.7",
		"@tanstack/react-form": "^1.33.5",
		"classnames": "^2.5.1",
		"drizzle-orm": "^1.0.0-rc.5",
		"object-path": "^0.11.8",
		"radix-ui": "^1.4.3",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-server-dom-webpack": "19.2.8",
		"rwsdk": "1.7.5",
		"rwsdk-atp": "git+https://tangled.org/arsdehnel.com/rwsdk-atp.git",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@atproto/lex": "^0.4.4",
		"@biomejs/biome": "^2.5.5",
		"@cloudflare/vite-plugin": "1.50.0",
		"@cloudflare/workers-types": "5.20260801.1",
		"@commitlint/cli": "^20.4.1",
		"@commitlint/config-conventional": "^20.4.1",
		"@libsql/client": "^0.18.0",
		"@mdx-js/rollup": "^3.1.1",
		"@storybook/test": "^8.6.15",
		"@tanstack/react-devtools": "^0.10.14",
		"@tanstack/react-form-devtools": "^0.2.34",
		"@types/node": "~26.1.2",
		"@types/object-path": "^0.11.4",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"chalk-template": "^1.1.3",
		"drizzle-kit": "^1.0.0-rc.5",
		"gray-matter": "^4.0.3",
		"husky": "^9.1.7",
		"knip": "^6.32.2",
		"less": "^4.9.1",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-packagejson": "^3.0.2",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-mdx-frontmatter": "^6.0.0",
		"tsx": "^4.21.0",
		"typescript": "7.0.2",
		"typescript-plugin-css-modules": "^5.3.0",
		"vite": "~8.2.0",
		"wrangler": "4.118.0"
	},
	"packageManager": "pnpm@12.7.0"
}
