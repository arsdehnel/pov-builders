{
	"name": "stance-build",
	"version": "0.0.1",
	"private": true,
	"description": "Build a real and shareable stance on the messy topics of the real world",
	"keywords": [],
	"license": "MIT",
	"author": "",
	"type": "module",
	"main": "src/worker.tsx",
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write .",
		"build": "vite build",
		"ci:lint": "pnpm types:check && pnpm biome:check && pnpm knip:check",
		"ci:tests": "pnpm build",
		"clean": "npm run clean:vite",
		"clean:vite": "rm -rf ./node_modules/.vite",
		"deploy": "rw-scripts ensure-deploy-env && npm run clean && vite build --mode $CLOUDFLARE_ENV && wrangler d1 migrations apply D1_JEOPARDY --remote --env $CLOUDFLARE_ENV && wrangler deploy --env $CLOUDFLARE_ENV",
		"dev": "vite dev",
		"dev:docker": "vite dev --mode docker",
		"dev:init": "rw-scripts dev-init",
		"docker:down": "docker compose down -v",
		"docker:up": "docker compose up -d",
		"generate": "rw-scripts ensure-env && wrangler types --include-runtime false && tsx scripts/fix-env-types.ts",
		"knip:check": "knip",
		"knip:fix": "knip --fix",
		"prepare": "husky",
		"prettier:check": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"preview": "vite preview",
		"release": "./scripts/semantic-release.sh",
		"release:dry-run": "./scripts/semantic-release.sh --dry-run --no-ci",
		"staged:lint": "lint-staged --allow-empty",
		"types:check": "tsc"
	},
	"dependencies": {
		"@radix-ui/react-icons": "^1.3.2",
		"radix-ui": "^1.4.3",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-server-dom-webpack": "19.2.8",
		"rwsdk": "1.7.5",
		"rwsdk-atp": "git+https://tangled.org/arsdehnel.com/rwsdk-atp.git#cebf8a2b45a4e14ad09d791b49c4e3a3fac5201a"
	},
	"devDependencies": {
		"@atproto/lex": "^0.4.4",
		"@biomejs/biome": "^2.5.5",
		"@cloudflare/vite-plugin": "1.50.0",
		"@cloudflare/workers-types": "5.20260801.1",
		"@commitlint/cli": "^20.4.1",
		"@commitlint/config-conventional": "^20.4.1",
		"@types/node": "~26.1.2",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"husky": "^9.1.7",
		"knip": "^6.32.2",
		"lint-staged": "^16.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-packagejson": "^3.0.2",
		"tsx": "^4.21.0",
		"typescript": "7.0.2",
		"vite": "~8.2.0",
		"wrangler": "4.118.0"
	},
	"packageManager": "pnpm@12.7.0"
}
