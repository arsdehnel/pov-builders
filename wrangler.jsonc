{
	// Schema reference for wrangler configuration
	"$schema": "node_modules/wrangler/config-schema.json",

	// Name of your worker
	"name": "stance-build",

	// Entry point for your worker
	"main": "src/worker.tsx",

	// Compatibility settings
	"compatibility_date": "2025-08-21",
	"compatibility_flags": ["nodejs_compat"],

	// Assets configuration
	"assets": {
		"binding": "ASSETS"
	},

	// Observability settings
	"observability": {
		"enabled": true
	},

	"durable_objects": {
		"bindings": [
			{
				"name": "DO_BROWSER_SESSION",
				"class_name": "BrowserSessionDurableObject"
			},
			{
				"name": "DO_OAUTH_TOKEN",
				"class_name": "AtpOAuthDurableObject"
			}
		]
	},
	"d1_databases": [
		{
			"binding": "D1_STANCE_BUILD",
			"database_name": "stance-build-local",
			"database_id": "local",
			"migrations_dir": "drizzle",
			"migrations_pattern": "drizzle/*/migration.sql"
		}
	],
	"exports": {
		"BrowserSessionDurableObject": { "type": "durable-object", "storage": "sqlite" },
		"AtpOAuthDurableObject": { "type": "durable-object", "storage": "sqlite" }
	},
	"kv_namespaces": [{ "binding": "KV_OAUTH_STATE", "id": "KV_OAUTH_STATE_LOCAL" }],
	"queues": {
		"consumers": [
			{
				"queue": "queue-tap-webhook-local",
				"max_batch_size": 10,
				"max_batch_timeout": 5
			}
		],
		"producers": [
			{
				"binding": "QUEUE_TAP_WEBHOOK",
				"queue": "queue-tap-webhook-local"
			}
		]
	},
	"secrets": {
		"required": ["BROWSER_SESSION_SIGNING_KEY", "OAUTH_STATE_KV_ENCRYPTION_KEYS", "OAUTH_TOKEN_KV_ENCRYPTION_KEYS"]
	},

	// Environment variables
	"vars": {
		"ATPROTO_OAUTH_SCOPE": "atproto repo:xyz.statusphere.status",
		"SESSION_ID_COOKIE_KEY": "stance-build-session-id",
		"SESSION_TIMEOUT_SECONDS": 1209600
	},

	"env": {
		"docker": {
			"durable_objects": {
				"bindings": [
					{
						"name": "DO_BROWSER_SESSION",
						"class_name": "BrowserSessionDurableObject"
					},
					{
						"name": "DO_OAUTH_TOKEN",
						"class_name": "AtpOAuthDurableObject"
					}
				]
			},
			"d1_databases": [
				{
					"binding": "D1_STANCE_BUILD",
					"database_name": "stance-build-local",
					"database_id": "local",
					"migrations_dir": "drizzle",
					"migrations_pattern": "drizzle/*/migration.sql"
				}
			],
			"queues": {
				"consumers": [
					{
						"queue": "queue-tap-webhook-docker",
						"max_batch_size": 10,
						"max_batch_timeout": 5
					}
				],
				"producers": [
					{
						"binding": "QUEUE_TAP_WEBHOOK",
						"queue": "queue-tap-webhook-docker"
					}
				]
			},
			"kv_namespaces": [{ "binding": "KV_OAUTH_STATE", "id": "KV_OAUTH_STATE_DOCKER" }],
			"secrets": {
				"required": ["BROWSER_SESSION_SIGNING_KEY", "OAUTH_STATE_KV_ENCRYPTION_KEYS", "OAUTH_TOKEN_KV_ENCRYPTION_KEYS"]
			},
			"vars": {
				"ATPROTO_OAUTH_SCOPE": "atproto repo:xyz.statusphere.status",
				"SESSION_ID_COOKIE_KEY": "stance-build-session-id",
				"SESSION_TIMEOUT_SECONDS": 1209600,
				"ATPROTO_PDS_URL": "http://localhost:3000",
				"ATPROTO_PLC_URL": "http://localhost:2582",
				"ATPROTO_TAP_URL": "http://localhost:2480"
			}
		}
	}
}
