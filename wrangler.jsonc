{
	// Schema reference for wrangler configuration
	"$schema": "node_modules/wrangler/config-schema.json",

	// Name of your worker
	"name": "pov-builders",

	// Entry point for your worker
	"main": "src/worker.tsx",

	// Compatibility settings
	"compatibility_date": "2025-08-21",
	"compatibility_flags": ["nodejs_compat"],

	// Assets configuration
	"assets": {
		"binding": "ASSETS"
	},

	// Observability settings
	"observability": {
		"enabled": true
	},

	"durable_objects": {
		"bindings": [
			{
				"name": "DO_BROWSER_SESSION",
				"class_name": "BrowserSessionDurableObject"
			},
			{
				"name": "DO_ATP_AUTH",
				"class_name": "AtpOAuthDurableObject"
			}
		]
	},
	"d1_databases": [
		{
			"binding": "D1_POV_BUILDERS",
			"database_name": "pov-builders-local",
			"database_id": "local",
			"migrations_dir": "drizzle",
			"migrations_pattern": "drizzle/*/migration.sql"
		}
	],
	"exports": {
		"BrowserSessionDurableObject": { "type": "durable-object", "storage": "sqlite" },
		"AtpOAuthDurableObject": { "type": "durable-object", "storage": "sqlite" }
	},
	"kv_namespaces": [{ "binding": "KV_OAUTH_STATE", "id": "KV_OAUTH_STATE_LOCAL" }],
	"secrets": {
		"required": [
			"ALLOWED_DIDS",
			"ATP_SERVICE_APP_PASSWORD",
			"ATP_SERVICE_DID",
			"BROWSER_SESSION_SIGNING_KEY",
			"OAUTH_STATE_KV_ENCRYPTION_KEYS",
			"OAUTH_TOKEN_KV_ENCRYPTION_KEYS"
		]
	},

	// Environment variables
	"vars": {
		"APP_BASE_URL": "http://127.0.0.1:5173",
		"ATPROTO_OAUTH_USE_LOOPBACK_OVERRIDE": "true",
		"ATPROTO_OAUTH_SCOPE": "atproto",
		"SESSION_ID_COOKIE_KEY": "pov-builders-session-id",
		"SESSION_TIMEOUT_SECONDS": 1209600
	},

	"env": {
		"docker": {
			"durable_objects": {
				"bindings": [
					{
						"name": "DO_BROWSER_SESSION",
						"class_name": "BrowserSessionDurableObject"
					},
					{
						"name": "DO_ATP_AUTH",
						"class_name": "AtpOAuthDurableObject"
					}
				]
			},
			"d1_databases": [
				{
					"binding": "D1_POV_BUILDERS",
					"database_name": "pov-builders-local",
					"database_id": "local",
					"migrations_dir": "drizzle",
					"migrations_pattern": "drizzle/*/migration.sql"
				}
			],
			"kv_namespaces": [{ "binding": "KV_OAUTH_STATE", "id": "KV_OAUTH_STATE_DOCKER" }],
			"secrets": {
				"required": [
					"ATP_SERVICE_APP_PASSWORD",
					"ATP_SERVICE_DID",
					"BROWSER_SESSION_SIGNING_KEY",
					"OAUTH_STATE_KV_ENCRYPTION_KEYS",
					"OAUTH_TOKEN_KV_ENCRYPTION_KEYS"
				]
			},
			"vars": {
				"APP_BASE_URL": "http://127.0.0.1:5173",
				"ATPROTO_OAUTH_USE_LOOPBACK_OVERRIDE": "true",
				"ATPROTO_OAUTH_SCOPE": "atproto",
				"ATPROTO_HANDLE_RESOLVE_URL_OVERRIDE": "http://localhost:3000",
				"ATPROTO_PLC_URL_OVERRIDE": "http://localhost:2582",
				"SESSION_ID_COOKIE_KEY": "pov-builders-session-id",
				"SESSION_TIMEOUT_SECONDS": 1209600
			}
		},
		"integration": {
			"routes": [
				{
					"pattern": "int.pov.builders",
					"custom_domain": true
				}
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "DO_BROWSER_SESSION",
						"class_name": "BrowserSessionDurableObject"
					},
					{
						"name": "DO_ATP_AUTH",
						"class_name": "AtpOAuthDurableObject"
					}
				]
			},
			// pnpm exec wrangler d1 create pov-builders-integration
			"d1_databases": [
				{
					"binding": "D1_POV_BUILDERS",
					"database_name": "pov-builders-integration",
					"database_id": "a8f7707d-c060-4a26-b64a-a4ef45d29fc3",
					"migrations_dir": "drizzle",
					"migrations_pattern": "drizzle/*/migration.sql"
				}
			],
			// pnpm exec wrangler kv namespace create pov-builders-oauth-state-integration
			"kv_namespaces": [{ "binding": "KV_OAUTH_STATE", "id": "0875d02368e745c6869dbcde47a90b4a" }],
			// pnpm wrangler secret put <secret binding> --env integration
			"secrets": {
				"required": [
					"ALLOWED_DIDS",
					"ATP_SERVICE_APP_PASSWORD",
					"ATP_SERVICE_DID",
					"BROWSER_SESSION_SIGNING_KEY",
					"OAUTH_STATE_KV_ENCRYPTION_KEYS",
					"OAUTH_TOKEN_KV_ENCRYPTION_KEYS"
				]
			},
			"vars": {
				"APP_BASE_URL": "https://int.pov.builders",
				"ATPROTO_OAUTH_SCOPE": "atproto",
				"SESSION_ID_COOKIE_KEY": "pov-builders-session-id",
				"SESSION_TIMEOUT_SECONDS": 1209600
			}
		}
	}
}
